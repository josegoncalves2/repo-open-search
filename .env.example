# ---------------------------------------------------------------------------
# OpenSearch stack - variaveis de ambiente
# Copie para .env e ajuste. O .env NAO vai para o Git (ver .gitignore).
# ---------------------------------------------------------------------------
OPENSEARCH_VERSION=3.8.0

CLUSTER_NAME=opensearch-cluster
NODE_NAME=opensearch-node1

# Senha do usuario 'admin' (RESERVADO no OpenSearch 3.x). Precisa passar no
# zxcvbn (>=8 chars, maiuscula, minuscula, numero, especial, sem palavras
# comuns / sequencias). Fica como conta de servico/emergencia.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=TrocarForte!2026Key

# Superusuario EFETIVO - criado pelo 'provisioner' com all_access.
# Login do dia a dia (Dashboards + API + healthchecks).
# A Security REST API valida a forca da senha com zxcvbn e rejeitaria
# 'pmotiadm' ("Weak password"). O provisioner contorna aplicando a senha
# como HASH bcrypt (campo "hash"), que o validador nao inspeciona - por isso
# qualquer valor aqui, forte ou fraco, e aceito. Ver scripts/lib.sh e README.
OPENSEARCH_ADMIN_USER=pmotiadm
OPENSEARCH_ADMIN_PASSWORD=pmotiadm

# Heap da JVM. 1536m: os modelos de ML precisam de folga alem dos 512m iniciais.
OPENSEARCH_JAVA_OPTS=-Xms1536m -Xmx1536m --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow

# Limites de memoria dos containers
OPENSEARCH_MEM_LIMIT=3g
DASHBOARDS_MEM_LIMIT=1g

# Portas publicadas no host
OPENSEARCH_PORT=9200
OPENSEARCH_PERF_PORT=9600
DASHBOARDS_PORT=5601
ENROLL_PORT=80

# --------------------------- LLM remoto (OpenRouter) -----------------------
LLM_PROVIDER=openrouter
LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=minimax/minimax-m3:free
LLM_API_KEY=coloque-sua-chave-openrouter-aqui

# Modelo local de embeddings (neural/semantic search e RAG) - pre-treinado OpenSearch
EMBEDDING_MODEL=huggingface/sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VERSION=1.0.2

# Usuario de ingestao dos agentes Fluent Bit (criado por setup-agent-user.sh)
AGENT_USER=agent-ingest
AGENT_PASS=TrocarAgenteForte2026!
